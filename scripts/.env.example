# ============================================================================
# LECCIONARIO - Variables de entorno para deploy
# Copia este archivo a .env y ajusta los valores
# ============================================================================

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leccionario
DB_USER=postgres
DB_PASS=CAMBIAR_ESTO

# --- JWT ---
JWT_SECRET=GENERAR_SECRETO_SEGURO_MINIMO_32_CHARS

# --- CORS (solo scheme+host+puerto, sin paths) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:1080

# --- Servidor ---
HOST_PORT=1080
CONTAINER_PORT=1080
SPRING_PROFILES_ACTIVE=prod
